<Project>
  <PropertyGroup>
    <RepoRootPath>$(MSBuildThisFileDirectory)</RepoRootPath>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <WinSDKVersion>10.0.26100.0</WinSDKVersion>
    <DotNetTargets>net10.0-windows$(WinSDKVersion)</DotNetTargets>
    <TargetCPUs>AnyCPU;x64;x86;ARM64</TargetCPUs>
    <Platforms>$(TargetCPUs)</Platforms>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AnalysisLevel>10.0</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(TF_BUILD)' == 'true'">true</ContinuousIntegrationBuild>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <BaseOutputPath>$(RepoRootPath)artifacts/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(RepoRootPath)artifacts/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <PackageOutputPath>$(RepoRootPath)artifacts/packages/$(Configuration)/</PackageOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(RepoRootPath)file/keys/strongname.snk</AssemblyOriginatorKeyFile>
    <VersionPrefix>0.4.0</VersionPrefix>
    <VersionSuffix>net10-preview.1</VersionSuffix>
    <Company>Arkaen Solutions</Company>
    <Authors>Aaron T. Carter, Arkaen Solutions, Contributors</Authors>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/atcarter714/DXSharp</RepositoryUrl>
    <PackageProjectUrl>https://github.com/atcarter714/DXSharp</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IncludeSymbols>true</IncludeSymbols>
    <DebugType>portable</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Preserve legacy source branches until the COM ownership migration. -->
    <DefineConstants>$(DefineConstants);DEV_BUILD;CACHE_SIZE_NORMAL</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">$(DefineConstants);DEBUG_COM</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(RepoRootPath)README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
