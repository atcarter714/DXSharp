<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <IsTestProject>false</IsTestProject>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/DXSharp.Core/DXSharp.Core.csproj" /><ProjectReference Include="../../src/DXSharp.DirectML/DXSharp.DirectML.csproj" /></ItemGroup>
  <Target Name="CopyNativeFixture" AfterTargets="Build" Condition="'$(DXSharpNativeFixture)' != ''">
    <Copy SourceFiles="$(DXSharpNativeFixture)" DestinationFolder="$(TargetDir)" />
  </Target>
</Project>
