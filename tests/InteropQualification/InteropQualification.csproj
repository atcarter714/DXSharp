<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <IsTestProject>false</IsTestProject>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../samples/Shared/StaticMeshSet.cs" Link="StaticMeshSet.cs" />
    <ProjectReference Include="../../src/DXSharp.Core/DXSharp.Core.csproj" />
    <ProjectReference Include="../../src/DXSharp.DirectML/DXSharp.DirectML.csproj" />
    <ProjectReference Include="../../src/DXSharp.Assets/DXSharp.Assets.csproj" />
    <Compile Include="../../samples/FleetBattler/FrontierHud.cs" Link="FrontierHud.cs" />
    <Compile Include="../../samples/FleetBattler/PlanetInspector.cs" Link="PlanetInspector.cs" />
    <None Include="../../samples/FleetBattler/Art/OperationsAtlas.jpg" Link="Art/OperationsAtlas.jpg"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="../../samples/FleetBattler/OrbitalNavigation.cs" Link="OrbitalNavigation.cs" />
    <Compile Include="../../samples/FleetBattler/Frontier.cs" Link="Frontier.cs" />
    <Compile Include="../../samples/FleetBattler/FleetSimulation.cs" Link="FleetSimulation.cs" />
    <Compile Include="../../samples/FleetBattler/FleetDraw.cs" Link="FleetDraw.cs" />
    <Compile Include="../../samples/FleetBattler/SpaceDraw.cs" Link="SpaceDraw.cs" />
    <Compile Include="../../samples/FleetBattler/FleetHud.cs" Link="FleetHud.cs" />
    <Compile Include="../../samples/FleetBattler/CelestialSystem.cs" Link="CelestialSystem.cs" />
    <Compile Include="../../samples/FleetBattler/ComputeTraffic.cs" Link="ComputeTraffic.cs" />
    <Compile Include="../../samples/FleetBattler/Jukebox.cs" Link="Jukebox.cs" />
    <Compile Include="../../samples/FleetBattler/VorbisTrack.cs" Link="VorbisTrack.cs" />
    <PackageReference Include="NVorbis" />
    <None Update="Audio/TestTone.ogg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="../../samples/FleetBattler/SynthAudio.cs" Link="SynthAudio.cs" />
    <Compile Include="../../samples/FleetBattler/FleetCombat.cs" Link="FleetCombat.cs" />
    <Compile Include="../../samples/FleetBattler/PlanetEconomy.cs" Link="PlanetEconomy.cs" />
    <Compile Include="../../samples/FleetBattler/CommandSelection.cs" Link="CommandSelection.cs" />
    <Compile Include="../../samples/FleetBattler/BattleDraw.cs" Link="BattleDraw.cs" />
    <None Include="../../samples/FleetBattler/Shaders/*.hlsl" Link="Shaders/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../samples/StaticModelViewer/Models/Patrol.gltf" Link="Models/Patrol.gltf"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../samples/FleetBattler/Models/*.gltf" Link="Models/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyNativeFixture" AfterTargets="Build" Condition="'$(DXSharpNativeFixture)' != ''">
    <Copy SourceFiles="$(DXSharpNativeFixture)" DestinationFolder="$(TargetDir)" />
  </Target>
</Project>
