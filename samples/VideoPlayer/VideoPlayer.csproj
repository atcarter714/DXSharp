<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="Platform">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>$(DotNetTargets)</TargetFramework>
    <UseWinUI>true</UseWinUI><UseWindowsForms>false</UseWindowsForms><WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><Platform>x64</Platform><PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest><DXSharpCopyDxcRuntime>false</DXSharpCopyDxcRuntime>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/WinUISampleDiagnostics.cs" Link="WinUISampleDiagnostics.cs" />
    <ProjectReference Include="../../src/DXSharp.Framework.WinUI/DXSharp.Framework.WinUI.csproj" />
    <ProjectReference Include="../../src/DXSharp.Media/DXSharp.Media.csproj" />
    <None Update="Assets/*.mp4;Assets/manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
