<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>$(DotNetTargets)</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms><DXSharpCopyDxcRuntime>false</DXSharpCopyDxcRuntime><DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <DefineConstants>$(DefineConstants);NATIVE_HOST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DXSharp.Framework/DXSharp.Framework.csproj" />
    <Compile Include="../CharacterLab/Program.cs" Link="Program.cs" />
    <Compile Include="../CharacterLab/OrbitCamera.cs" Link="OrbitCamera.cs" />
    <Compile Include="../CharacterLab/CharacterScene.cs" Link="CharacterScene.cs" />
    <None Include="../CharacterLab/Assets/**/*" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
