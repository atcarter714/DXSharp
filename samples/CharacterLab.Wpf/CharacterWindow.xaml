<Window x:Class="DXSharp.CharacterLab.Wpf.CharacterWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="clr-namespace:DXSharp.Framework.Wpf;assembly=DXSharp.Framework.Wpf"
        Title="DXSharp · Character Lab — WPF" Width="1280" Height="820" MinWidth="760" MinHeight="520"
        Background="#0B111D" Foreground="#DFEAF3" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,8" /><Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="Background" Value="#203449" /><Setter Property="Foreground" Value="#DFEAF3" />
    </Style>
  </Window.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <StackPanel><TextBlock Text="ARKAEN / DXSHARP" Foreground="#64D8CD" FontSize="12" />
        <TextBlock Text="CHARACTER LAB" FontSize="28" FontWeight="SemiBold" /></StackPanel>
      <TextBlock Text="WPF + DIRECT3D 12" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#93AFC3" />
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <Border Background="#121E2C" CornerRadius="6" Padding="16">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="PLAYBACK" Foreground="#64D8CD" Margin="0,0,0,12" />
            <TextBlock x:Name="ModelSummary" Foreground="#93AFC3" Margin="0,0,0,12" />
            <TextBlock Text="Animation clip" Margin="0,0,0,6" />
            <ComboBox x:Name="Clips" SelectionChanged="ClipChanged" />
            <CheckBox x:Name="Paused" Content="Pause animation" Foreground="#DFEAF3" Margin="0,16,0,8" Checked="PauseChanged" Unchecked="PauseChanged" />
            <TextBlock Text="Playback speed" />
            <Slider x:Name="Speed" Minimum="0.1" Maximum="2.5" Value="1" Margin="0,8,0,12" ValueChanged="SpeedChanged" />
            <Button Content="Reset camera" Click="ResetCamera" />
            <TextBlock Text="KEYBOARD FOCUS" Foreground="#64D8CD" Margin="0,24,0,8" />
            <TextBlock Text="Edit here to test that viewport shortcuts leave text input alone." Foreground="#93AFC3" Margin="0,0,0,8" />
            <TextBox Text="Character notes…" Padding="6" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="Click the scene, then drag to orbit. Use +/− to zoom, 1–9 for clips, and Space to pause. Tab moves between the viewport and WPF controls." Foreground="#93AFC3" VerticalAlignment="Bottom" Margin="0,24,0,0" />
        </DockPanel>
      </Border>
      <Border Grid.Column="2" BorderBrush="#294056" BorderThickness="1">
        <dx:D3D12Viewport x:Name="Viewport" />
      </Border>
    </Grid>
    <StackPanel Grid.Row="2" Margin="0,12,0,0">
      <TextBlock x:Name="Status" Foreground="#64D8CD" />
      <TextBlock Text="Native child HWND · fenced frame slots · precompiled shaders · WPF controls occupy adjacent layout regions" Foreground="#718DA4" FontSize="11" Margin="0,4,0,0" />
    </StackPanel>
  </Grid>
</Window>
