<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Build tasks intentionally ship under tasks rather than exposing a runtime reference assembly. -->
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
    <IsPackable>true</IsPackable><IncludeBuildOutput>false</IncludeBuildOutput>
    <Description>Incremental DXC shader compilation for SDK-style MSBuild projects.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Utilities.Core" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Direct3D.DXC" IncludeAssets="none" PrivateAssets="none" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(TargetDir)$(TargetName).pdb" Pack="true" PackagePath="tasks/netstandard2.0/" />
    <None Include="$(TargetPath)" Pack="true" PackagePath="tasks/netstandard2.0/" />
    <None Include="../../build/msbuild/DXSharp.Shaders.targets" Pack="true" PackagePath="buildTransitive/DXSharp.Tools.Builds.targets" />
  </ItemGroup>
</Project>
