<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(DotNetTargets)</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Description>A modern DirectX 12 binding for .NET. Experimental .NET 10 migration baseline.</Description>
    <PackageIcon>DXSharp_Logo_00_512.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.Win32Metadata" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Direct3D.D3D12" GeneratePathProperty="true" PrivateAssets="all" />
    <None Include="../../file/img/DXSharp_Logo_00_512.png" Pack="true" PackagePath="/" />
  </ItemGroup>
	<!-- Internal Visibility :: -->
	<ItemGroup>
		<!-- Here, DXSharp internals can be exposed to outside assemblies if required ... 
			 (For example, internals are already exposed to "BasicTests" unit testing assembly ... -->
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>
				BasicTests, 
			</_Parameter1>
		</AssemblyAttribute>
		
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>
				DXSharp.Framework, 
			</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>
</Project>
