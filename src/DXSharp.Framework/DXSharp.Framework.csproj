<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(DXSharpTargetFrameworks)</TargetFrameworks>
    <Description>Game timing, lifecycle, animation and rendering services for DXSharp.</Description>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1570;CS1572;CS1573;CS1574;CS1584;CS1658</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Graphics/Skinned.hlsl" />
    <ProjectReference Include="../DXSharp.Core/DXSharp.Core.csproj" />
    <ProjectReference Include="../DXSharp.Assets/DXSharp.Assets.csproj" />
  </ItemGroup>
</Project>
