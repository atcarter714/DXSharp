<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)$(Configuration)/generated</CompilerGeneratedFilesOutputPath>
    <!-- The .NET COM generator emits undocumented forwarding declarations. -->
    <NoWarn>$(NoWarn);CS1591;CS1574</NoWarn>
    <Description>Public source-generated DirectX graphics, audio, input, DXC, and DirectML native interfaces and data types for Windows x64.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DXSharp.Core" Key="" />
    <PackageReference Include="Microsoft.Windows.CsWin32" VersionOverride="[0.3.367]" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.Win32Metadata" VersionOverride="[71.0.37-preview]" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>
</Project>
