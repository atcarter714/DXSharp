<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(DXSharpTargetFrameworks)</TargetFrameworks>
    <PlatformTarget>x64</PlatformTarget>
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/generated</CompilerGeneratedFilesOutputPath>
    <!-- The .NET COM generator emits undocumented forwarding declarations. -->
    <NoWarn>$(NoWarn);CS1591;CS1574</NoWarn>
    <Description>Public source-generated DirectX graphics, audio, input, DXC, and DirectML native interfaces and data types for Windows x64.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DXSharp.Core" Key="" />
    <PackageReference Include="Microsoft.Windows.CsWin32" VersionOverride="0.3.371" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.Win32Metadata" VersionOverride="[71.0.45-preview]" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.Direct3D.D3D12" VersionOverride="[1.620.2]" PrivateAssets="all" IncludeAssets="build" GeneratePathProperty="true" />
    <AppLocalAllowedLibraries Include="$(PkgMicrosoft_Direct3D_D3D12)/build/native/bin/x64/D3D12Core.dll;$(PkgMicrosoft_Direct3D_D3D12)/build/native/bin/x64/d3d12SDKLayers.dll;$(PkgMicrosoft_Direct3D_D3D12)/build/native/bin/x64/D3D12StateObjectCompiler.dll" />
  </ItemGroup>
</Project>
