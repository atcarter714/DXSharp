<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)$(Configuration)/generated</CompilerGeneratedFilesOutputPath>
    <Description>Source-generated DirectX foundation and deterministic ownership for DXSharp.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" VersionOverride="[0.3.367]" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.Win32Metadata" VersionOverride="[71.0.37-preview]" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Direct3D.D3D12" VersionOverride="[1.620.1]" GeneratePathProperty="true" IncludeAssets="runtime;native" />
    <PackageReference Include="Microsoft.Direct3D.DXC" VersionOverride="[1.9.2609.5]" GeneratePathProperty="true" IncludeAssets="runtime;native" />
    <InternalsVisibleTo Include="InteropQualification" Key="" />
    <InternalsVisibleTo Include="DXSharp.DirectML" Key="" />
    <None Include="../../build/msbuild/DXSharp.Core.targets" Pack="true" PackagePath="buildTransitive/DXSharp.Core.targets" />
    <None Include="../../build/msbuild/NativeDependencies.targets" Pack="true" PackagePath="buildTransitive/DXSharp.NativeAssets.targets" />
  </ItemGroup>
</Project>
